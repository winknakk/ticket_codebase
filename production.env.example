# ─── System Environment ──────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# The origin LINE and browsers reach this backend on. MUST be https:// in
# production: the onboarding carousel builds image URLs from it and refuses a
# plain-http origin, and that refusal aborts the whole LINE webhook handler
# with a 503 rather than just the card.
#
# This line was missing from the template, so a deployment made from it fell
# back to the http://localhost:3000 default in src/config/env.ts. Already
# onboarded users never notice - their session skips the carousel - so the
# failure only reaches new users, and looks intermittent.
BACKEND_PUBLIC_URL=https://your-backend-domain-here

# ─── Database Configurations ─────────────────────────────────
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://automationx:changeme@automationx-postgres-primary:5432/automationx
DATABASE_REPLICA_URL=postgresql://automationx:changeme@automationx-postgres-replica:5432/automationx

# ─── Database Client Pool Settings ───────────────────────────
DB_POOL_MAX=15
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_CONNECTION_TIMEOUT_MS=3000

# ─── Disaster Recovery Encryption ─────────────────────────────
# Key must be exactly 32 characters for AES-256-CBC
BACKUP_ENCRYPTION_KEY=super-secret-backup-key-32-chars!

# ─── Redis Caching & BullMQ Configuration ─────────────────────
QUEUE_PROVIDER=redis
CACHE_PROVIDER=redis
REDIS_URL=redis://automationx-redis:6379

# Human takeover policy: claim deadline, idle renewal window, and hard cap.
HUMAN_PENDING_TIMEOUT_MINUTES=5
HUMAN_ACTIVE_TIMEOUT_MINUTES=15
HUMAN_MAX_SESSION_MINUTES=60

# ─── Integration MCP Services ─────────────────────────────────
NOCODB_BASE_URL=https://app.nocodb.com/
NOCODB_TOKEN=your-nocodb-token-here

PROMPTX_MCP_URL=https://wf.promptxai.com/api/v1/projects/...
# The client code automatically prepends "Bearer " - do not add it here.
PROMPTX_MCP_TOKEN=your-mcp-token-here

# ─── Security Middlwares ─────────────────────────────────────
API_KEY=your-api-key-here

# Signs operator session tokens AND AgentX execution-context tokens.
# REQUIRED in production - the server refuses to boot without it, because
# without it every guarded route fails closed and no ticket can be created.
# Minimum 32 characters. Generate with: openssl rand -base64 48
# Rotating it invalidates all operator sessions and all in-flight execution
# contexts (bounded by their 30-minute TTL).
SESSION_SECRET=
WEBHOOK_SECRET=your-webhook-hmac-secret-here
# Enforce webhook auth on /api/v1/webhooks/human_notify. Leave false until the
# published Main AI Core flow sends x-webhook-secret, then set to true.
STRICT_WEBHOOK_AUTH=false
# Password-free sign-in for the demo customer accounts. Never enable in
# production - the server refuses to boot if it is set there.
ALLOW_DEMO_LOGIN=false
PLANE_WEBHOOK_SECRET=your-plane-webhook-secret-here
PLANE_REVERSE_SYNC_ENABLED=false
PLANE_REVERSE_SYNC_INTERVAL_MS=30000
PLANE_REVERSE_SYNC_BATCH_SIZE=25
# SLA cadence engine: enable on exactly ONE instance. Dev reminders are sent by
# the PromptX "Plane Webhook Notification Flow" (Gmail as apagent.test@gmail.com);
# set its webhook URL here or reminders are skipped with a warning.
SLA_CADENCE_ENABLED=false
SLA_CADENCE_INTERVAL_MS=900000
SLA_NOTIFICATION_FLOW_WEBHOOK_URL=
SLA_CADENCE_LOOKBACK_DAYS=14
SLA_CADENCE_MAX_SENDS_PER_RUN=25
# Only notify when the slot boundary was crossed this recently; stops a
# backlog blast when the engine is switched on.
SLA_CADENCE_CATCHUP_GRACE_MINUTES=30
DEV_NOTIFICATION_FALLBACK_EMAIL=natapohnagain@gmail.com
# Two-step close follow-ups (same engine): nudge a silent customer after N
# business days, close automatically after M business days (0 = off).
RESOLUTION_NUDGE_BUSINESS_DAYS=1
RESOLUTION_AUTO_CLOSE_BUSINESS_DAYS=3
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─── Agent Reasoning Controls ────────────────────────────────
MAX_AGENT_HANDOFF_DEPTH=3
POLICY_FILE_PATH=data/policies.json
